{
  "name": "docx-preview-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.0.9",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter viewer dev",
    "dev:playground": "pnpm --filter playground dev",
    "build": "pnpm --filter @apollo-design/docx-preview build",
    "build:viewer": "pnpm --filter viewer build",
    "build:all": "pnpm -r build",
    "test": "pnpm --filter @apollo-design/docx-preview test",
    "watch": "pnpm --filter @apollo-design/docx-preview watch"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.59.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-vue": "^6.0.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "terser": "^5.51.2",
    "typescript": "^5.0.3",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.1.0",
    "vue": "^3.5.42",
    "vue-tsc": "^3.3.11"
  }
}
