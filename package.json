{
  "name": "docx-preview-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.0.9",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter playground dev",
    "dev:viewer": "pnpm --filter viewer dev",
    "build": "pnpm --filter @apollo-design/docx-preview build",
    "build:viewer": "pnpm --filter viewer build",
    "build:site": "pnpm --filter playground... build",
    "build:all": "pnpm -r build",
    "test": "pnpm --filter @apollo-design/docx-preview test",
    "watch": "pnpm --filter @apollo-design/docx-preview watch",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@microsoft/api-extractor": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "prettier": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "terser": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vue": "catalog:",
    "vue-tsc": "catalog:"
  }
}
