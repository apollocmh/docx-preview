{
  "name": "@apollo-design/react-docx-preview",
  "version": "0.3.0",
  "description": "React DOCX viewer component (toolbar, pager, zoom, thumbnails) built on @apollo-design/docx-preview",
  "keywords": [
    "word",
    "docx",
    "preview",
    "viewer",
    "react"
  ],
  "license": "Apache-2.0",
  "author": "apollocmh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apollocmh/docx-preview.git",
    "directory": "packages/react-docx-preview"
  },
  "homepage": "https://apollocmh.github.io/docx-preview/",
  "bugs": "https://github.com/apollocmh/docx-preview/issues",
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": {
      "development": "./src/styles/viewer.css",
      "default": "./dist/style.css"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "react": ">=17",
    "react-dom": ">=17"
  },
  "dependencies": {
    "@apollo-design/docx-preview": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit"
  }
}
